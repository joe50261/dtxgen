{
  "name": "dtxgen-web",
  "version": "2.3.0",
  "description": "純前端 DTX 自動製譜:音檔/譜包 zip → DTXMania 四難度譜包。demucs 分離 + ADTOF 鼓偵測(ONNX Runtime Web,WebGPU/WASM),難度簡化學自 28 首真實譜包;全部運算在瀏覽器內,零後端、檔案不離機。",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "python3 -m http.server 8080 -d app",
    "serve": "npx --yes serve app -l 8080",
    "sync-vendor": "node scripts/sync-vendor.mjs",
    "check-model": "node scripts/check-model.mjs",
    "test": "node tests/test_keysounds.mjs && node tests/smoke.mjs",
    "postinstall": "node scripts/sync-vendor.mjs"
  },
  "dependencies": {
    "demucs": "^1.0.0"
  },
  "devDependencies": {
    "onnxruntime-web": "^1.23.0"
  },
  "keywords": [
    "dtx",
    "dtxmania",
    "drum-transcription",
    "demucs",
    "adtof",
    "onnxruntime-web",
    "webgpu"
  ]
}
